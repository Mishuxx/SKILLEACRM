generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("bg-indigo-500")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
}

model Task {
  id               String       @id @default(cuid())
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  assignee         String       @default("Ricardo Pulgar") // Daniela Medina, Gustavo Mujica, Ricardo Pulgar
  priority         String       @default("medium")        // low, medium, high, urgent
  dueDate          String?
  meetingReference String?
  tags             String[]     @default([])
  columnId         String       @default("backlog")       // backlog, in_progress, in_review, done
  subtasks         Json         @default("[]")            // Array de { id, title, completed }
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String   @default("1")
  userName     String
  projectId    String?
  projectName  String?
  action       String   // CREATED, MOVED, DELETED, MEETING_INGESTED, etc.
  taskTitle    String?
  fromColumn   String?
  toColumn     String?
  meetingTitle String?
  timestamp    DateTime @default(now())
}
